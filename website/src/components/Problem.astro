---
const constraints = [
  {
    num: "01",
    title: "Sustained Event Throughput",
    spec: "100M+ frames/sec",
    body: "Collider readouts and superconducting detector arrays stream tens to hundreds of millions of hits per second. Lock-based queues stall immediately on cross-core cache-line bouncing.",
  },
  {
    num: "02",
    title: "Bounded Tail Latency",
    spec: "Sub-microsecond p99.9",
    body: "Hardware read-out FIFOs have fixed depth. A single kernel sleep or OS page fault overflows front-end buffers and permanently drops physics events.",
  },
  {
    num: "03",
    title: "Zero-Allocation Hot Paths",
    spec: "0 heap allocs after start()",
    body: "Dynamic allocations, virtual calls, and contention on the ingest core inject unpredictable jitter and destroy L1/L2 instruction locality.",
  },
  {
    num: "04",
    title: "Verifiable Integrity",
    spec: "CRC32C + TLA+ / Lean 4",
    body: "Persisted telemetry pages must detect silent bit-flips at memory bandwidth while proving core ring-buffer invariants cannot race, tear, or deadlock.",
  },
];
---

<section id="problem" class="border-t border-white/[0.06] bg-[#0E1117] py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Left: Editorial framing -->
      <div class="lg:col-span-5">
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-[#14B8A6] uppercase">
          The Problem
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-[40px] sm:leading-[1.12]">
          Conventional queues fail at detector rates.
        </h2>
        <p class="mt-5 text-base leading-[1.65] text-[#A1A6B3]">
          High-energy physics DAQ and quantum sensor pipelines sit directly behind front-end readout electronics where every cycle and cache line counts.
        </p>
        <p class="mt-4 text-sm leading-[1.65] text-[#8B93A4]">
          ChronoRing replaces mutex-guarded staging with cache-aligned lock-free rings, planar SoA vector filtering, and memory-mapped persistence.
        </p>
      </div>

      <!-- Right: Aligned 2-column grid per row so index + title + body share an exact vertical axis -->
      <div class="lg:col-span-7">
        <div class="divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {constraints.map((c) => (
            <div class="group py-6 first:pt-5 last:pb-5 sm:py-7">
              <div class="grid grid-cols-[2rem_1fr] items-baseline gap-x-4">
                <span class="font-mono text-xs font-medium text-[#3B82F6]">{c.num}</span>
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg font-semibold tracking-[-0.015em] text-white transition-colors duration-150 group-hover:text-[#93C5FD]">
                      {c.title}
                    </h3>
                    <span class="font-mono text-xs font-medium text-[#14B8A6]">{c.spec}</span>
                  </div>
                  <p class="mt-2.5 text-sm leading-[1.65] text-[#A1A6B3]">
                    {c.body}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
