---
const stages = [
  {
    step: "01",
    title: "Ingestion",
    spec: "64 B EventFrame",
    body: "Detector front-ends push fixed 64-byte cache-aligned frames or stage events directly in Structure-of-Arrays pages with zero heap allocation.",
  },
  {
    step: "02",
    title: "Lock-Free Ring",
    spec: "SPSC · MPSC · SHM",
    body: "Wait-free single-producer rings cache shadow head/tail cursors to avoid cross-core cache invalidation; Vyukov MPSC and shared-memory IPC scale across threads and processes.",
  },
  {
    step: "03",
    title: "SIMD Trigger",
    spec: "AVX2 · AVX-512 · NEON",
    body: "Vectorized trigger kernels evaluate energy, timing, pileup, and flag predicates across 8–16 events per cycle, producing compact 64-bit pass bitmasks.",
  },
  {
    step: "04",
    title: "Columnar Sink",
    spec: "57,408 B mmap + CRC32C",
    body: "Selected events transpose into page-aligned .crng columnar blocks with optional stack-only LZ4 compression and hardware CRC32C checksums.",
  },
];

const designDocUrl =
  "https://github.com/OmarAhmedTHE25th/ChronoRing/blob/main/docs/DESIGN.md";
---

<section id="architecture" class="border-b border-white/[0.06] bg-[#19191C] py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-[#3B82F6] uppercase">
          Architecture Overview
        </p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.03em] text-[#F4F5F7] sm:text-4xl">
          Deterministic dataflow from sensor edge to disk.
        </h2>
      </div>
      <a
        href={designDocUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-[#A1A6B3] transition-colors hover:text-[#F4F5F7]"
      >
        <span>Full architecture specification</span>
        <svg viewBox="0 0 20 20" class="h-4 w-4 text-[#3B82F6]" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 10h10m-4-4l4 4-4 4" />
        </svg>
      </a>
    </div>

    <!-- Clean visual pipeline diagram -->
    <div class="mt-12 rounded-2xl border border-white/[0.08] bg-[#131316] p-6 sm:p-10">
      <div class="grid grid-cols-1 items-center gap-4 lg:grid-cols-7 lg:gap-0">
        <!-- Stage 1 -->
        <div class="rounded-xl border border-white/[0.09] bg-[#202126] p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-medium text-[#6E7485]">STAGE 01</span>
            <span class="h-2 w-2 rounded-full bg-[#3B82F6]/70"></span>
          </div>
          <div class="mt-2 text-base font-semibold text-[#F4F5F7]">Ingestion</div>
          <div class="mt-1 font-mono text-xs text-[#60A5FA]">64 B EventFrame</div>
          <p class="mt-3 text-xs leading-relaxed text-[#A1A6B3]">
            Reserve-commit write · FPGA / Cryo / PCIe edge
          </p>
        </div>

        <!-- Connector 1 -> 2 -->
        <div class="flex items-center justify-center py-1 lg:px-2" aria-hidden="true">
          <svg class="hidden h-6 w-full lg:block" viewBox="0 0 64 24" fill="none">
            <line x1="2" y1="12" x2="54" y2="12" stroke="#3B82F6" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="3 3" />
            <path d="M51 7l6 5-6 5" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="h-6 w-6 lg:hidden" viewBox="0 0 24 24" fill="none">
            <path d="M12 4v14m-4-4l4 4 4-4" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- Stage 2 -->
        <div class="rounded-xl border border-white/[0.09] bg-[#202126] p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-medium text-[#6E7485]">STAGE 02</span>
            <span class="h-2 w-2 rounded-full bg-[#3B82F6]/80"></span>
          </div>
          <div class="mt-2 text-base font-semibold text-[#F4F5F7]">Lock-Free Ring</div>
          <div class="mt-1 font-mono text-xs text-[#60A5FA]">acquire / release</div>
          <p class="mt-3 text-xs leading-relaxed text-[#A1A6B3]">
            Cached shadow indices · Zero-mutex SPSC / MPSC
          </p>
        </div>

        <!-- Connector 2 -> 3 -->
        <div class="flex items-center justify-center py-1 lg:px-2" aria-hidden="true">
          <svg class="hidden h-6 w-full lg:block" viewBox="0 0 64 24" fill="none">
            <line x1="2" y1="12" x2="54" y2="12" stroke="#3B82F6" stroke-opacity="0.65" stroke-width="1.5" stroke-dasharray="3 3" />
            <path d="M51 7l6 5-6 5" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="h-6 w-6 lg:hidden" viewBox="0 0 24 24" fill="none">
            <path d="M12 4v14m-4-4l4 4 4-4" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- Stage 3 -->
        <div class="rounded-xl border border-[#3B82F6]/35 bg-[#202126] p-5 shadow-[0_0_24px_rgba(59,130,246,0.08)]">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-medium text-[#93C5FD]">STAGE 03</span>
            <span class="h-2 w-2 rounded-full bg-[#3B82F6]"></span>
          </div>
          <div class="mt-2 text-base font-semibold text-[#F4F5F7]">SIMD Trigger</div>
          <div class="mt-1 font-mono text-xs text-[#60A5FA]">SoA Bitmask Filter</div>
          <p class="mt-3 text-xs leading-relaxed text-[#A1A6B3]">
            Runtime ISA dispatch · Energy, timing &amp; pileup
          </p>
        </div>

        <!-- Connector 3 -> 4 -->
        <div class="flex items-center justify-center py-1 lg:px-2" aria-hidden="true">
          <svg class="hidden h-6 w-full lg:block" viewBox="0 0 64 24" fill="none">
            <line x1="2" y1="12" x2="54" y2="12" stroke="#3B82F6" stroke-opacity="0.85" stroke-width="1.5" stroke-dasharray="3 3" />
            <path d="M51 7l6 5-6 5" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg class="h-6 w-6 lg:hidden" viewBox="0 0 24 24" fill="none">
            <path d="M12 4v14m-4-4l4 4 4-4" stroke="#3B82F6" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- Stage 4 -->
        <div class="rounded-xl border border-white/[0.09] bg-[#202126] p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-medium text-[#6E7485]">STAGE 04</span>
            <span class="h-2 w-2 rounded-full bg-[#60A5FA]"></span>
          </div>
          <div class="mt-2 text-base font-semibold text-[#F4F5F7]">Columnar Sink</div>
          <div class="mt-1 font-mono text-xs text-[#60A5FA]">.crng mmap Pages</div>
          <p class="mt-3 text-xs leading-relaxed text-[#A1A6B3]">
            57,408 B SoA pages · Stack LZ4 + HW CRC32C
          </p>
        </div>
      </div>

      <!-- Observability / Control sidecar ribbon -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-white/[0.07] pt-5 text-xs text-[#A1A6B3]">
        <div class="flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-[#3B82F6]"></span>
          <span>Side-channel lock-free HDR latency histogram (<code class="text-[#F4F5F7]">p50</code> / <code class="text-[#F4F5F7]">p99</code> / <code class="text-[#F4F5F7]">p99.9</code>) + reject-reason counters</span>
        </div>
        <span class="font-mono text-[#6E7485]">Dual-write WAL · Arrow C ABI · Raft quorum</span>
      </div>
    </div>

    <!-- 4-column detailed breakdown -->
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {stages.map((s) => (
        <div class="rounded-2xl border border-white/[0.07] bg-[#202126]/45 p-6">
          <div class="flex items-center justify-between font-mono text-xs">
            <span class="text-[#6E7485]">{s.step}</span>
            <span class="text-[#3B82F6]">{s.spec}</span>
          </div>
          <h3 class="mt-3 text-base font-semibold text-[#F4F5F7]">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#A1A6B3]">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
