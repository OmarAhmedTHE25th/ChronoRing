---
const githubUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing";

const heroMetrics = [
  { value: "198.15 M", unit: "items/s", label: "SPSC Ring" },
  { value: "~4.9×", unit: "faster", label: "vs. Mutex Queue" },
  { value: "422.20 M", unit: "events/s", label: "AVX2 Trigger" },
  { value: "4.97", unit: "GiB/s", label: "HW CRC32C" },
];

const glassCards = [
  {
    label: "Wait-Free Rings",
    meta: "SPSC · Vyukov MPSC · SHM",
    href: "#problem",
    accent: false,
    icon: "ring",
  },
  {
    label: "SIMD SoA Triggers",
    meta: "AVX-512 · AVX2 · NEON",
    href: "#architecture",
    accent: false,
    icon: "bolt",
  },
  {
    label: "Columnar .crng Sink",
    meta: "57,408 B mmap + LZ4",
    href: "#performance",
    accent: false,
    icon: "layers",
  },
  {
    label: "TLA+ & Lean 4 Proofs",
    meta: "Machine-checked safety",
    href: "#design",
    accent: true,
    icon: "shield",
  },
];
---

<section class="relative overflow-hidden bg-[#050609] pt-20 pb-24 sm:pt-28 sm:pb-32 lg:pt-32 lg:pb-36">
  <!-- Sculptural layered geometric planes inspired by kotlinlang.org -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="kotlin-grain absolute inset-0 opacity-25"></div>
    <svg
      class="absolute -top-24 -right-24 h-[760px] w-[1120px] max-w-none opacity-95 sm:-top-16 sm:right-[-6%] lg:right-0"
      viewBox="0 0 1120 760"
      fill="none"
    >
      <defs>
        <linearGradient id="plane-deep" x1="120" y1="60" x2="960" y2="700" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#0B132B" />
          <stop offset="55%" stop-color="#172554" />
          <stop offset="100%" stop-color="#0F172A" />
        </linearGradient>
        <linearGradient id="plane-mid" x1="300" y1="80" x2="1040" y2="620" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#1D4ED8" stop-opacity="0.92" />
          <stop offset="58%" stop-color="#2563EB" stop-opacity="0.88" />
          <stop offset="100%" stop-color="#0284C7" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="plane-front" x1="480" y1="180" x2="1080" y2="700" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#2563EB" />
          <stop offset="48%" stop-color="#0EA5E9" />
          <stop offset="100%" stop-color="#14B8A6" />
        </linearGradient>
        <radialGradient id="hero-aura" cx="0.68" cy="0.38" r="0.55">
          <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.26" />
          <stop offset="60%" stop-color="#1D4ED8" stop-opacity="0.08" />
          <stop offset="100%" stop-color="#050609" stop-opacity="0" />
        </radialGradient>
      </defs>

      <rect width="1120" height="760" fill="url(#hero-aura)" />

      <rect
        x="210"
        y="-40"
        width="680"
        height="680"
        rx="128"
        transform="rotate(-14 550 300)"
        fill="url(#plane-deep)"
        stroke="rgba(255,255,255,0.08)"
        stroke-width="1.2"
      />

      <rect
        x="380"
        y="40"
        width="620"
        height="620"
        rx="112"
        transform="rotate(-8 690 350)"
        fill="url(#plane-mid)"
        stroke="rgba(147,197,253,0.22)"
        stroke-width="1.2"
      />

      <rect
        x="590"
        y="220"
        width="540"
        height="540"
        rx="96"
        transform="rotate(9 860 490)"
        fill="url(#plane-front)"
        fill-opacity="0.86"
        stroke="rgba(255,255,255,0.28)"
        stroke-width="1.5"
      />

      <circle
        cx="885"
        cy="360"
        r="210"
        stroke="rgba(255,255,255,0.12)"
        stroke-width="1"
        stroke-dasharray="4 8"
      />
    </svg>
    <!-- Protective contrast scrim behind left column + seamless bottom fade -->
    <div class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-[#050609] via-[#050609]/85 to-transparent lg:w-3/5"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#050609] to-transparent"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-12">
      <!-- Left: Title -> Subtitle -> Metrics -> CTAs -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.04] px-3.5 py-1.5 font-mono text-[11px] font-medium tracking-wide text-[#CBD5E1] backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-[#14B8A6]"></span>
          <span>C++20 · Zero-Allocation · TLA+ &amp; Lean 4</span>
        </div>

        <h1 class="mt-6 text-5xl font-bold tracking-[-0.04em] text-white sm:text-6xl lg:text-[76px] lg:leading-[1.0]">
          ChronoRing
        </h1>

        <p class="mt-5 text-xl font-medium tracking-[-0.02em] text-[#E5E7EB] sm:text-2xl sm:leading-[1.3]">
          Wait-free. Vectorized. Formally verified.
        </p>

        <p class="mt-3.5 max-w-xl text-base leading-[1.65] text-[#9CA3AF]">
          Lock-free ring transport, runtime AVX2/AVX-512 SIMD triggers, and memory-mapped columnar storage built for high-energy physics DAQ pipelines.
        </p>

        <!-- Key metrics strip -->
        <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-white/[0.1] py-6 sm:grid-cols-4">
          {heroMetrics.map((m) => (
            <div class="flex flex-col">
              <div class="tabular-metrics text-[22px] leading-tight font-bold tracking-tight whitespace-nowrap text-white">
                {m.value}
              </div>
              <div class="mt-0.5 font-mono text-[11px] font-medium whitespace-nowrap text-[#38BDF8]">
                {m.unit}
              </div>
              <div class="mt-1.5 text-xs font-medium whitespace-nowrap text-[#9CA3AF]">{m.label}</div>
            </div>
          ))}
        </div>

        <!-- Primary & Secondary CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-full bg-[#3B82F6] px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_28px_rgba(37,99,235,0.36)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#2563EB] hover:shadow-[0_12px_34px_rgba(37,99,235,0.5)]"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-current" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>View on GitHub</span>
          </a>

          <a
            href="#architecture"
            class="inline-flex items-center gap-2 rounded-full border border-white/[0.2] bg-[#050609]/60 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:border-white/45 hover:bg-white/[0.06]"
          >
            <span>Read the Design</span>
          </a>
        </div>
      </div>

      <!-- Right: Readable frosted-glass capability rows -->
      <div class="lg:col-span-5">
        <div class="flex flex-col gap-3">
          {glassCards.map((card) => (
            <a
              href={card.href}
              class={`group flex items-center justify-between rounded-xl border px-5 py-4 backdrop-blur-md transition-all duration-200 ${
                card.accent
                  ? "border-white/30 bg-gradient-to-r from-[#1E40AF]/95 via-[#1D4ED8]/95 to-[#0F766E]/95 text-white shadow-[0_10px_28px_rgba(0,0,0,0.35)] hover:-translate-y-0.5 hover:border-white/55 hover:brightness-110"
                  : "border-white/[0.18] bg-[#090D18]/90 text-white shadow-[0_8px_24px_rgba(0,0,0,0.35)] hover:-translate-y-0.5 hover:border-[#7DD3FC]/65 hover:bg-[#0D1426]/95 hover:shadow-[0_12px_30px_rgba(0,0,0,0.48)]"
              }`}
            >
              <div class="flex items-center gap-4">
                <div
                  class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border ${
                    card.accent
                      ? "border-white/25 bg-white/15 text-white"
                      : "border-white/[0.1] bg-[#162036]/90 text-[#7DD3FC]"
                  }`}
                >
                  {card.icon === "ring" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="12" cy="12" r="8" stroke-dasharray="16 6" />
                      <circle cx="12" cy="12" r="2.5" fill="currentColor" />
                    </svg>
                  )}
                  {card.icon === "bolt" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 3L4 14h7l-1 7 9-11h-7l1-7z" />
                    </svg>
                  )}
                  {card.icon === "layers" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l9 4.5-9 4.5-9-4.5L12 3z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9 4.5 9-4.5M3 16.5L12 21l9-4.5" />
                    </svg>
                  )}
                  {card.icon === "shield" && (
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6l7-3z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                    </svg>
                  )}
                </div>
                <div>
                  <div class="text-[15px] font-semibold tracking-tight text-white">{card.label}</div>
                  <div class={`mt-0.5 font-mono text-xs ${card.accent ? "text-white/90" : "text-[#CBD5E1]"}`}>
                    {card.meta}
                  </div>
                </div>
              </div>

              <svg
                viewBox="0 0 20 20"
                class={`h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1 ${
                  card.accent ? "text-white" : "text-[#CBD5E1] group-hover:text-white"
                }`}
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m-4-4l4 4-4 4" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
