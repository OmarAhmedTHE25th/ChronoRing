---
const benchmarks = [
  {
    value: "198.15 M",
    unit: "items/s",
    title: "SPSC Ring Throughput",
    callout: "5.05 ns/op",
    detail: "Wait-free single-producer single-consumer transfers using cache-line padding and producer-private shadow tail caching.",
    barPercent: 94,
    baseline: "vs. 40.5 M/s uncached atomics",
    ratioLabel: "5.05 ns/op",
  },
  {
    value: "~4.9×",
    unit: "faster",
    title: "Cross-Thread Queue Speedup",
    callout: "Zero kernel sleeps",
    detail: "Avoids std::mutex contention, condition-variable wakeups, and cache-line bouncing across physical CPU cores.",
    barPercent: 84,
    baseline: "vs. std::mutex + std::condition_variable",
    ratioLabel: "~4.9× speedup",
  },
  {
    value: "422.20 M",
    unit: "events/s",
    title: "SIMD SoA Trigger (AVX2)",
    callout: "2.40× over scalar",
    detail: "Processes planar float and quality-flag arrays directly in 256-bit YMM registers without AoS reconstruction.",
    barPercent: 98,
    baseline: "vs. 175.9 M/s scalar trigger path",
    ratioLabel: "2.40× speedup",
  },
  {
    value: "4.97",
    unit: "GiB/s",
    title: "Hardware CRC32C Throughput",
    callout: "22.1× over software",
    detail: "Verifies 57,408-byte ColumnarPage payloads and headers at memory-bus rates using SSE4.2 / ARMv8 CRC intrinsics.",
    barPercent: 91,
    baseline: "vs. 0.22 GiB/s lookup-table fallback",
    ratioLabel: "22.1× speedup",
  },
];
---

<section id="performance" class="relative overflow-hidden border-t border-white/[0.06] bg-[#050609] py-24 sm:py-32">
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[380px] w-[760px] -translate-x-1/2 rounded-full bg-[#2563EB]/[0.08] blur-[140px]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-[#14B8A6] uppercase">
          Performance
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-[40px] sm:leading-[1.12]">
          Measured at hardware limits.
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-[1.65] text-[#A1A6B3]">
        Google Benchmark suites compiled in Release mode (<code class="text-[#E2E8F0]">-O2/-O3</code>, AVX2/NEON, hardware CRC32C).
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2">
      {benchmarks.map((b) => (
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/[0.09] bg-[#0F1219] p-8 transition-all duration-200 hover:border-[#3B82F6]/45 hover:bg-[#131823]">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#38BDF8]/50 to-transparent opacity-0 transition-opacity duration-200 group-hover:opacity-100"></div>

          <div>
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-sm font-semibold text-[#D1D5DB]">{b.title}</h3>
              <span class="rounded-full border border-[#3B82F6]/30 bg-[#3B82F6]/10 px-3 py-0.5 font-mono text-[11px] font-medium whitespace-nowrap text-[#93C5FD]">
                {b.callout}
              </span>
            </div>

            <div class="mt-7 flex items-baseline gap-2.5">
              <span class="tabular-metrics bg-gradient-to-r from-white via-[#F1F5F9] to-[#93C5FD] bg-clip-text text-5xl font-bold tracking-[-0.04em] text-transparent sm:text-[54px] sm:leading-none">
                {b.value}
              </span>
              <span class="font-mono text-base font-medium text-[#14B8A6]">
                {b.unit}
              </span>
            </div>

            <p class="mt-4 text-sm leading-[1.65] text-[#A1A6B3]">{b.detail}</p>
          </div>

          <div class="mt-8 pt-2">
            <div class="flex items-center justify-between font-mono text-[11px] text-[#8B93A4]">
              <span>{b.baseline}</span>
              <span class="text-[#38BDF8]">{b.ratioLabel}</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/[0.06]">
              <div
                class="h-full rounded-full bg-gradient-to-r from-[#2563EB] via-[#38BDF8] to-[#14B8A6] transition-all duration-300 group-hover:brightness-110"
                style={`width: ${b.barPercent}%;`}
              ></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
