---
const githubUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing";
const docsUrl = `${githubUrl}#readme`;
const designUrl = `${githubUrl}/blob/main/docs/DESIGN.md`;
const formalUrl = `${githubUrl}/tree/main/formal`;
const licenseUrl = `${githubUrl}/blob/main/LICENSE`;
---

<footer class="bg-[#19191C] py-16">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="flex flex-col justify-between gap-10 border-b border-white/[0.07] pb-12 md:flex-row md:items-start">
      <div class="max-w-sm">
        <div class="flex items-center gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 32 32"
            class="h-6 w-6"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="16" cy="16" r="11" stroke="#3B82F6" stroke-opacity="0.28" stroke-width="2.5" />
            <path d="M16 5A11 11 0 0 1 27 16" stroke="#3B82F6" stroke-width="2.75" stroke-linecap="round" />
            <path d="M23.78 23.78A11 11 0 0 1 8.22 23.78" stroke="#60A5FA" stroke-width="2.75" stroke-linecap="round" />
            <path d="M5 16A11 11 0 0 1 12 5.75" stroke="#93C5FD" stroke-width="2.75" stroke-linecap="round" />
            <circle cx="16" cy="16" r="2.75" fill="#F4F5F7" />
          </svg>
          <span class="text-base font-semibold tracking-tight text-[#F4F5F7]">ChronoRing</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-[#6E7485]">
          Standalone C++20 lock-free ring buffer, SIMD trigger engine, and zero-copy columnar storage for high-rate scientific data acquisition.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h3 class="font-mono text-xs font-medium tracking-wider text-[#F4F5F7] uppercase">
            Project
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-[#A1A6B3]">
            <li>
              <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
                GitHub Repository
              </a>
            </li>
            <li>
              <a href="#performance" class="transition-colors hover:text-white">
                Benchmarks
              </a>
            </li>
            <li>
              <a href="#code" class="transition-colors hover:text-white">
                C++20 Examples
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-mono text-xs font-medium tracking-wider text-[#F4F5F7] uppercase">
            Documentation
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-[#A1A6B3]">
            <li>
              <a href={docsUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
                README &amp; Quickstart
              </a>
            </li>
            <li>
              <a href={designUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
                Architecture Spec
              </a>
            </li>
            <li>
              <a href={formalUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
                TLA+ &amp; Lean 4 Proofs
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-mono text-xs font-medium tracking-wider text-[#F4F5F7] uppercase">
            Legal
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-[#A1A6B3]">
            <li>
              <a href={licenseUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">
                MIT License
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-4 text-xs text-[#6E7485] sm:flex-row sm:items-center">
      <p>Released under the MIT License. Built with C++20, CMake, TLA+, and Lean 4.</p>
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[#A1A6B3] transition-colors hover:text-white"
      >
        OmarAhmedTHE25th/ChronoRing
      </a>
    </div>
  </div>
</footer>
