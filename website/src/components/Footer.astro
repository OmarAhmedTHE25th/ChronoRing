---
const githubUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing";
const docsUrl = `${githubUrl}#readme`;
const designUrl = `${githubUrl}/blob/main/docs/DESIGN.md`;
const formalUrl = `${githubUrl}/tree/main/formal`;
const licenseUrl = `${githubUrl}/blob/main/LICENSE`;

const footerLinks = [
  { label: "GitHub Repository", href: githubUrl },
  { label: "Documentation", href: docsUrl },
  { label: "Architecture Spec", href: designUrl },
  { label: "TLA+ & Lean 4 Proofs", href: formalUrl },
  { label: "MIT License", href: licenseUrl },
];
---

<footer>
  <!-- Full-width electric-blue to teal gradient CTA band -->
  <section class="relative overflow-hidden bg-gradient-to-r from-[#1D4ED8] via-[#0284C7] to-[#0D9488] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-[-0.03em] text-white sm:text-[42px] sm:leading-[1.12]">
          Start streaming with ChronoRing.
        </h2>
        <p class="mt-4 max-w-xl text-base leading-[1.65] text-white/90">
          Zero-allocation C++20 rings, SIMD SoA triggers, and formally checked memory-order safety for detector telemetry.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-[#111318] px-6 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-[#1E222B]"
          >
            View on GitHub
          </a>
          <a
            href={docsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-colors duration-150 hover:bg-white/20"
          >
            Read Documentation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Minimal technical footer band -->
  <div class="bg-[#1B1D24] py-12 text-sm text-[#A1A6B3]">
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <nav aria-label="Footer navigation">
        <ul class="m-0 flex list-none flex-wrap items-center gap-x-8 gap-y-3 border-b border-white/[0.08] p-0 pb-8 text-[13px] font-medium text-[#D1D5DB]">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors duration-150 hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <div class="flex items-center gap-2.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 32 32"
            class="h-5 w-5 shrink-0"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="16" cy="16" r="11" stroke="#3B82F6" stroke-opacity="0.3" stroke-width="2.5" />
            <path d="M16 5A11 11 0 0 1 27 16" stroke="#3B82F6" stroke-width="2.75" stroke-linecap="round" />
            <path d="M23.78 23.78A11 11 0 0 1 8.22 23.78" stroke="#14B8A6" stroke-width="2.75" stroke-linecap="round" />
            <circle cx="16" cy="16" r="2.75" fill="#F4F5F7" />
          </svg>
          <span class="font-semibold tracking-tight text-white">ChronoRing</span>
          <span class="font-mono text-xs text-[#8B93A4]">v1.2.0</span>
        </div>

        <p class="text-xs text-[#8B93A4]">
          Released under the MIT License · C++20, CMake, TLA+, and Lean 4
        </p>
      </div>
    </div>
  </div>
</footer>
