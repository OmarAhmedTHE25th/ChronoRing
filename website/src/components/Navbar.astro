---
const githubUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing";

const navLinks = [
  { label: "Problem", href: "#problem" },
  { label: "Architecture", href: "#architecture" },
  { label: "Performance", href: "#performance" },
  { label: "Design", href: "#design" },
  { label: "Code", href: "#code" },
];
---

<header class="sticky top-0 z-50 border-b border-white/[0.08] bg-[#050609]/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6 sm:px-8">
    <!-- Left: Brand mark + version badge -->
    <a
      href="#"
      class="group inline-flex shrink-0 items-center gap-2.5 text-[#F4F5F7] transition-opacity duration-150 hover:opacity-90"
      aria-label="ChronoRing home"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        class="h-6 w-6 shrink-0 transition-transform duration-300 group-hover:rotate-45"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="16" cy="16" r="11" stroke="#3B82F6" stroke-opacity="0.28" stroke-width="2.5" />
        <path d="M16 5A11 11 0 0 1 27 16" stroke="#3B82F6" stroke-width="2.75" stroke-linecap="round" />
        <path d="M23.78 23.78A11 11 0 0 1 8.22 23.78" stroke="#14B8A6" stroke-width="2.75" stroke-linecap="round" />
        <path d="M5 16A11 11 0 0 1 12 5.75" stroke="#60A5FA" stroke-width="2.75" stroke-linecap="round" />
        <circle cx="16" cy="16" r="2.75" fill="#F4F5F7" />
      </svg>
      <span class="text-[16px] font-semibold tracking-[-0.02em] text-white">ChronoRing</span>
      <span class="rounded-md border border-white/[0.1] bg-white/[0.04] px-1.5 py-0.5 font-mono text-[10px] leading-none font-medium text-[#9CA3AF]">
        v1.2.0
      </span>
    </a>

    <!-- Center: Spaced semantic navigation list -->
    <nav class="hidden md:block" aria-label="Primary navigation">
      <ul class="m-0 flex list-none items-center gap-1 p-0 lg:gap-2">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center rounded-lg px-3.5 py-2 text-[14px] font-medium whitespace-nowrap text-[#B8BECB] transition-colors duration-150 hover:bg-white/[0.06] hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right: CTA + mobile menu toggle -->
    <div class="flex shrink-0 items-center gap-3">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center justify-center rounded-full bg-[#3B82F6] px-5 py-2 text-[13px] font-semibold whitespace-nowrap text-white shadow-[0_0_20px_rgba(59,130,246,0.28)] transition-all duration-150 hover:bg-[#2563EB] hover:shadow-[0_0_24px_rgba(59,130,246,0.45)] sm:inline-flex"
      >
        View on GitHub
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.1] bg-white/[0.04] text-[#C2C7D1] transition-colors duration-150 hover:bg-white/[0.08] hover:text-white md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-open" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-white/[0.08] bg-[#0B0D12] px-6 py-4 md:hidden"
  >
    <nav aria-label="Mobile navigation">
      <ul class="m-0 flex list-none flex-col gap-1 p-0">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-[#B8BECB] transition-colors duration-150 hover:bg-white/[0.06] hover:text-white"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-3 border-t border-white/[0.08] pt-3">
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex rounded-full bg-[#3B82F6] px-5 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#2563EB]"
        >
          View on GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("icon-open");
  const closeIcon = document.getElementById("icon-close");

  if (btn && menu && openIcon && closeIcon) {
    const toggle = () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden", expanded);
      openIcon.classList.toggle("hidden", !expanded);
      closeIcon.classList.toggle("hidden", expanded);
    };

    btn.addEventListener("click", toggle);
    document.querySelectorAll(".mobile-nav-link").forEach((el) => {
      el.addEventListener("click", () => {
        if (btn.getAttribute("aria-expanded") === "true") toggle();
      });
    });
  }
</script>
