---
const githubUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing";

const navLinks = [
  { label: "Problem", href: "#problem" },
  { label: "Architecture", href: "#architecture" },
  { label: "Performance", href: "#performance" },
  { label: "Design", href: "#design" },
  { label: "Code", href: "#code" },
];
---

<header class="sticky top-0 z-50 border-b border-white/[0.06] bg-[#19191C]/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 sm:px-8">
    <a
      href="#"
      class="group flex items-center gap-3 text-sm font-semibold tracking-tight text-[#F4F5F7] transition-colors hover:text-white"
      aria-label="ChronoRing home"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        class="h-7 w-7 transition-transform duration-300 group-hover:rotate-45"
        fill="none"
        aria-hidden="true"
      >
        <circle cx="16" cy="16" r="11" stroke="#3B82F6" stroke-opacity="0.28" stroke-width="2.5" />
        <path d="M16 5A11 11 0 0 1 27 16" stroke="#3B82F6" stroke-width="2.75" stroke-linecap="round" />
        <path d="M23.78 23.78A11 11 0 0 1 8.22 23.78" stroke="#60A5FA" stroke-width="2.75" stroke-linecap="round" />
        <path d="M5 16A11 11 0 0 1 12 5.75" stroke="#93C5FD" stroke-width="2.75" stroke-linecap="round" />
        <circle cx="16" cy="16" r="2.75" fill="#F4F5F7" />
      </svg>
      <span class="text-[15px] font-semibold tracking-[-0.02em]">ChronoRing</span>
      <span class="hidden rounded-full border border-white/[0.08] bg-white/[0.03] px-2 py-0.5 font-mono text-[11px] font-medium text-[#A1A6B3] sm:inline-block">
        C++20
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[#A1A6B3] transition-colors duration-200 hover:text-[#F4F5F7]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.04] px-4 py-1.5 text-sm font-medium text-[#F4F5F7] transition-all duration-200 hover:border-[#3B82F6]/50 hover:bg-[#3B82F6]/10"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.08] bg-white/[0.03] text-[#A1A6B3] transition-colors hover:text-white md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-open" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" d="M6 6l12 12M18 6l-12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/[0.06] bg-[#19191C] px-6 py-4 md:hidden"
  >
    <nav class="flex flex-col gap-3" aria-label="Mobile navigation">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link rounded-lg px-2 py-1.5 text-sm font-medium text-[#A1A6B3] transition-colors hover:bg-white/[0.04] hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("icon-open");
  const closeIcon = document.getElementById("icon-close");

  if (btn && menu && openIcon && closeIcon) {
    const toggle = () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden", expanded);
      openIcon.classList.toggle("hidden", !expanded);
      closeIcon.classList.toggle("hidden", expanded);
    };

    btn.addEventListener("click", toggle);
    document.querySelectorAll(".mobile-nav-link").forEach((el) => {
      el.addEventListener("click", () => {
        if (btn.getAttribute("aria-expanded") === "true") toggle();
      });
    });
  }
</script>
