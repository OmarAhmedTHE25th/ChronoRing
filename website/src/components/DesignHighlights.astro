---
const formalUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing/tree/main/formal";
const bindingsUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing/tree/main/bindings";

const languages = [
  { name: "C++20", core: true },
  { name: "Python", core: false },
  { name: "Rust", core: false },
  { name: "Go", core: false },
  { name: "Julia", core: false },
  { name: "C#", core: false },
  { name: "Java", core: false },
  { name: "LabVIEW", core: false },
  { name: "MATLAB", core: false },
  { name: "ISO C89", core: false },
];

const advancedCapabilities = [
  {
    title: "PCIe / CXL.mem P2P DMA",
    description:
      "Direct FPGA-to-ring peer-to-peer DMA transfers and zero-copy RDMA fabric transport across memory tiers.",
    source: "pcie_cxl_ring.hpp",
  },
  {
    title: "ChaCha20-Poly1305 OPE Triggers",
    description:
      "Per-detector AEAD event encryption with monotonic order-preserving ciphertexts and searchable flag trapdoors.",
    source: "event_crypto.hpp",
  },
  {
    title: "DDL Self-Hosting Compiler",
    description:
      "Generates detector-specialized constexpr C++20 pipelines directly from declarative .ddl.json specifications.",
    source: "chronoring_selfhost.py",
  },
];

const proofItems = [
  {
    file: "formal/tla/SpscRing.tla",
    property: "Wait-free cursor monotonicity & zero slot overwriting under TLC",
  },
  {
    file: "formal/tla/MpscRing.tla",
    property: "Vyukov per-slot sequence protocol linearizability & mutual exclusion",
  },
  {
    file: "formal/lean/ChronoRingProofs.lean",
    property: "Zero-sorry Lean 4 proofs of modular index disjointness & active ticket uniqueness",
  },
];

const pillars = [
  {
    kicker: "Concurrency",
    title: "Lock-Free & Wait-Free Rings",
    text: "Power-of-two SPSC, Fan-Out broadcast, Vyukov MPSC, and lock-free MPMC rings padded to 64-byte cache boundaries with zero-copy reserve/commit writes and cross-process SHM.",
    symbols: "SpscRingBuffer · MpscRingBuffer · ShmRing",
  },
  {
    kicker: "Vectorization",
    title: "SIMD Trigger Kernels",
    text: "Runtime ISA dispatch across AVX-512, AVX2, SSE4.2, NEON, SVE2, RVV, and WASM-SIMD128 — plus a DSL bytecode and native JIT compiler emitting packed 64-bit event masks.",
    symbols: "evaluate_columnar_page · compile_trigger_dsl",
  },
  {
    kicker: "Storage",
    title: "Zero-Copy Columnar Persistence",
    text: "Fixed 57,408-byte Structure-of-Arrays memory-mapped pages with projection masks, 16 KiB stack-only LZ4 block compression, group-commit WAL, and SHA-256 PageMerkleTree.",
    symbols: "ColumnarSink · ColumnarReader · DurableColumnarStore",
  },
  {
    kicker: "Interoperability",
    title: "Arrow, HDF5, ROOT & FFI",
    text: "Zero-copy Apache Arrow C Data Interface export, HDF5/Parquet/CERN ROOT schemas, incremental Python/Polars stream tailers, and bindings for Rust, Go, Julia, C#, Java, MATLAB, LabVIEW, and C89.",
    symbols: "ChronoArrowArray · export_hdf5_root_schema_json",
  },
];
---

<section id="design" class="border-t border-white/[0.06] bg-[#0E1117] py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-[0.14em] text-[#3B82F6] uppercase">
        Design Highlights
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-[40px] sm:leading-[1.12]">
        Systems precision backed by formal verification.
      </h2>
    </div>

    <!-- Spotlight banner for Formal Verification (TLA+ & Lean 4) -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-[#3B82F6]/30 bg-gradient-to-br from-[#0F172A] via-[#0D1322] to-[#0B1720] p-8 shadow-xl">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div class="inline-flex items-center rounded-full border border-[#14B8A6]/35 bg-[#14B8A6]/10 px-3 py-1 font-mono text-[11px] font-medium text-[#5EEAD4]">
            TLA+ &amp; Lean 4 Formal Methods
          </div>
          <h3 class="mt-4 text-2xl font-bold tracking-[-0.02em] text-white sm:text-3xl">
            Proven lock-free safety, not just stress-tested.
          </h3>
          <p class="mt-3 text-sm leading-[1.65] text-[#A1A6B3] sm:text-base">
            Core acquire/release ring protocols are checked exhaustively under TLC and verified in Lean 4 without <code class="text-[#E2E8F0]">sorry</code> placeholders.
          </p>
          <div class="mt-6">
            <a
              href={formalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-[#60A5FA] transition-colors duration-150 hover:text-white"
            >
              <span>Inspect proofs in formal/</span>
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10h10m-4-4l4 4-4 4" />
              </svg>
            </a>
          </div>
        </div>

        <div class="divide-y divide-white/[0.08] rounded-xl border border-white/[0.08] bg-[#070A11]/85 px-6 py-2 lg:col-span-6">
          {proofItems.map((p) => (
            <div class="py-4">
              <div class="font-mono text-xs font-medium text-[#38BDF8]">{p.file}</div>
              <p class="mt-1.5 text-sm leading-[1.55] text-[#CBD5E1]">{p.property}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Clean 2x2 hairline-ruled architectural pillar grid -->
    <div class="mt-14 grid grid-cols-1 gap-x-12 gap-y-12 md:grid-cols-2">
      {pillars.map((item) => (
        <article class="flex flex-col justify-between border-t border-white/[0.1] pt-7">
          <div>
            <div class="font-mono text-xs font-medium tracking-wider text-[#14B8A6] uppercase">
              {item.kicker}
            </div>
            <h3 class="mt-2.5 text-xl font-semibold tracking-[-0.02em] text-white">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-[1.65] text-[#A1A6B3]">
              {item.text}
            </p>
          </div>
          <div class="mt-5 font-mono text-xs text-[#8B93A4]">{item.symbols}</div>
        </article>
      ))}
    </div>

    <!-- Concise Ecosystem Bindings & Extreme Systems Strip -->
    <div class="mt-14 rounded-2xl border border-white/[0.09] bg-[#0B0E14]/90 p-7 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="font-mono text-xs font-medium tracking-[0.14em] text-[#38BDF8] uppercase">
          10 Languages &amp; FFI Bindings
        </span>
        <a
          href={bindingsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-xs text-[#9CA3AF] transition-colors duration-150 hover:text-white"
        >
          <span>bindings/</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
        {languages.map((lang) => (
          <li
            class={`rounded-lg border px-3 py-1.5 font-mono text-xs font-medium whitespace-nowrap ${
              lang.core
                ? "border-[#3B82F6]/45 bg-[#3B82F6]/15 text-[#93C5FD]"
                : "border-white/[0.1] bg-[#131823] text-[#E2E8F0]"
            }`}
          >
            {lang.name}
          </li>
        ))}
      </ul>

      <div class="mt-7 grid grid-cols-1 gap-6 border-t border-white/[0.08] pt-7 md:grid-cols-3">
        {advancedCapabilities.map((cap) => (
          <div class="flex flex-col justify-between">
            <div>
              <h4 class="text-sm font-semibold text-white">{cap.title}</h4>
              <p class="mt-1.5 text-xs leading-[1.6] text-[#A1A6B3]">{cap.description}</p>
            </div>
            <div class="mt-3 font-mono text-[11px] text-[#14B8A6]">{cap.source}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
