---
interface Snippet {
  id: string;
  label: string;
  filename: string;
  headerUrl: string;
  code: string;
}

interface QuickstartCommand {
  id: string;
  label: string;
  command: string;
}

const includeUrl = "https://github.com/OmarAhmedTHE25th/ChronoRing/tree/main/include/chronoring";

const quickstartCommands: QuickstartCommand[] = [
  {
    id: "cmake",
    label: "CMake Demo",
    command:
      "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j && ./build/chronoring --demo 100000 run.crng",
  },
  {
    id: "python",
    label: "Python",
    command:
      "cmake -B build -DCHRONORING_BUILD_SHARED=ON && cmake --build build -j && PYTHONPATH=python python3 python/examples/quickstart.py",
  },
  {
    id: "bench",
    label: "Benchmarks",
    command: "./build/bench_chronoring --benchmark_min_time=0.5s",
  },
];

const snippets: Snippet[] = [
  {
    id: "pipeline",
    label: "TelemetryPipeline",
    filename: "include/chronoring/pipeline.hpp",
    headerUrl: `${includeUrl}/pipeline.hpp`,
    code: `#include "chronoring/chronoring.hpp"
#include <cstdio>

int main() {
    chronoring::PipelineConfig cfg;
    cfg.output_path = "run_042.crng";
    cfg.trigger.min_energy_mev = 10.0f;
    cfg.trigger.max_abs_timing_ps = 120.0f;
    cfg.enable_compression = true;          // 16 KiB stack LZ4 + HW CRC32C
    cfg.projection_mask = chronoring::kColAll;

    chronoring::TelemetryPipeline pipeline(cfg);
    if (!pipeline.start()) return 1;

    chronoring::EventFrame ev{};
    ev.timestamp_ns  = 1000420ULL;
    ev.sequence_id   = 1;
    ev.detector_id   = 7;
    ev.energy_mev    = 48.5f;
    ev.timing_ps     = -18.0f;
    ev.quality_flags = chronoring::kFlagValid;
    ev.multiplicity  = 2;

    pipeline.submit_wait(ev);
    pipeline.stop();

    const auto st = pipeline.stats();
    std::printf("passed=%llu p99=%lluns\\n",
                static_cast<unsigned long long>(st.passed_events),
                static_cast<unsigned long long>(st.p99_ns));
    return 0;
}`,
  },
  {
    id: "ring",
    label: "SpscRingBuffer",
    filename: "include/chronoring/spsc_ring.hpp",
    headerUrl: `${includeUrl}/spsc_ring.hpp`,
    code: `#include "chronoring/spsc_ring.hpp"

void stream_detector_hit(
    chronoring::SpscRingBuffer<chronoring::EventFrame, 4096>& ring,
    double raw_adc) {
    // Producer writes directly into 64B cache-aligned ring memory
    if (auto* slot = ring.try_reserve_push()) {
        slot->timestamp_ns  = 4096000ULL;
        slot->sequence_id   = 1024;
        slot->energy_mev    = static_cast<float>(raw_adc * 1.25);
        slot->quality_flags = chronoring::kFlagValid;
        ring.commit_push();   // release fence publishes committed slot
    }

    // Consumer inspects in place before advancing cached tail
    if (const auto* frame = ring.try_peek()) {
        if ((frame->quality_flags & chronoring::kFlagValid) != 0u) {
            ring.consume_pop();
        }
    }
}`,
  },
  {
    id: "simd",
    label: "SIMD SoA Trigger",
    filename: "include/chronoring/soa_pipeline.hpp",
    headerUrl: `${includeUrl}/soa_pipeline.hpp`,
    code: `#include "chronoring/soa_pipeline.hpp"
#include <array>

std::size_t filter_page_soa(const chronoring::ColumnarPage& in_page,
                            chronoring::ColumnarPage& out_page) noexcept {
    chronoring::TriggerConfig trig;
    trig.min_energy_mev    = 5.0f;
    trig.max_energy_mev    = 5000.0f;
    trig.max_abs_timing_ps = 150.0f;
    trig.min_multiplicity  = 2;

    std::array<std::uint64_t, chronoring::kColumnarPageEvents / 64u> mask{};
    const std::size_t kept = chronoring::evaluate_columnar_page(
        in_page, trig, mask.data(), chronoring::SimdBackend::Auto);

    return kept > 0
        ? chronoring::compact_soa_page(in_page, mask.data(), out_page)
        : 0;
}`,
  },
];

function escapeHtml(text: string): string {
  return text
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

const cppTokenPattern =
  /(\/\/[^\n]*|^\s*#\s*[a-z]+|"(?:\\.|[^"\\])*"|\b(?:int|void|auto|const|constexpr|static_cast|return|if|noexcept|true|false|bool|double|float)\b|\b(?:chronoring|std|PipelineConfig|TelemetryPipeline|EventFrame|SpscRingBuffer|ColumnarPage|TriggerConfig|SimdBackend|size_t|uint64_t)\b|\b\d+(?:\.\d+)?(?:ULL|f|u)?\b)/gm;

function highlightCpp(source: string): string {
  let result = "";
  let lastIndex = 0;
  cppTokenPattern.lastIndex = 0;

  let match: RegExpExecArray | null;
  while ((match = cppTokenPattern.exec(source)) !== null) {
    result += escapeHtml(source.slice(lastIndex, match.index));
    const token = match[0];
    let cls = "";
    if (token.startsWith("//")) {
      cls = "tok-cm";
    } else if (token.trimStart().startsWith("#")) {
      cls = "tok-pp";
    } else if (token.startsWith('"')) {
      cls = "tok-str";
    } else if (/^\d/.test(token)) {
      cls = "tok-num";
    } else if (
      /^(int|void|auto|const|constexpr|static_cast|return|if|noexcept|true|false|bool|double|float)$/.test(
        token
      )
    ) {
      cls = "tok-kw";
    } else {
      cls = "tok-ty";
    }
    result += `<span class="${cls}">${escapeHtml(token)}</span>`;
    lastIndex = cppTokenPattern.lastIndex;
  }

  result += escapeHtml(source.slice(lastIndex));
  return result;
}
---

<section id="code" class="relative overflow-hidden border-t border-white/[0.06] bg-[#050609] py-24 sm:py-32">
  <!-- Sculpted blue/teal shapes peeking behind the right side of the code editor -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg
      class="absolute top-12 -right-28 h-[560px] w-[720px] opacity-80"
      viewBox="0 0 720 560"
      fill="none"
    >
      <defs>
        <linearGradient id="code-shape-back" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#1E3A8A" />
          <stop offset="100%" stop-color="#0F172A" />
        </linearGradient>
        <linearGradient id="code-shape-front" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#2563EB" />
          <stop offset="55%" stop-color="#0EA5E9" />
          <stop offset="100%" stop-color="#14B8A6" />
        </linearGradient>
      </defs>
      <rect
        x="120"
        y="40"
        width="440"
        height="440"
        rx="88"
        transform="rotate(14 340 260)"
        fill="url(#code-shape-back)"
        fill-opacity="0.72"
      />
      <rect
        x="260"
        y="140"
        width="380"
        height="380"
        rx="76"
        transform="rotate(28 450 330)"
        fill="url(#code-shape-front)"
        fill-opacity="0.78"
        stroke="rgba(255,255,255,0.2)"
        stroke-width="1.2"
      />
    </svg>
  </div>

  <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="font-mono text-xs font-medium tracking-[0.14em] text-[#38BDF8] uppercase">
          C++20 Interface
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-[40px] sm:leading-[1.12]">
          Zero-allocation by construction.
        </h2>
      </div>
      <span class="font-mono text-xs text-[#9CA3AF]">CMake · vcpkg · Conan · C99/C89 ABI</span>
    </div>

    <!-- Wide editor frame -->
    <div class="mt-10 overflow-hidden rounded-2xl border border-white/[0.1] bg-[#0B0E14]/95 shadow-[0_28px_90px_rgba(0,0,0,0.72)] backdrop-blur-md">
      <!-- Flush underline tab bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/[0.08] px-6 sm:px-7">
        <div class="flex items-center gap-6 overflow-x-auto" role="tablist" aria-label="ChronoRing C++20 code examples">
          {snippets.map((s, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              data-tab-target={s.id}
              class={`code-tab relative -mb-px shrink-0 border-b-2 py-3.5 text-sm font-medium whitespace-nowrap transition-colors duration-150 ${
                idx === 0
                  ? "border-[#38BDF8] text-white"
                  : "border-transparent text-[#A1A6B3] hover:text-white"
              }`}
            >
              {s.label}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-4 py-2.5">
          <a
            id="active-header-link"
            href={snippets[0].headerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-1.5 font-mono text-xs text-[#9CA3AF] transition-colors duration-150 hover:text-white sm:inline-flex"
          >
            <span>&lt;/&gt;</span>
            <span>Open Header</span>
          </a>

          <button
            id="copy-code-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/[0.12] bg-white/[0.04] px-3.5 py-1.5 font-mono text-xs font-medium text-[#CBD5E1] transition-colors duration-150 hover:border-white/30 hover:text-white"
          >
            <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="7" y="7" width="9" height="9" rx="1.5" />
              <path d="M4.5 13H4a1.5 1.5 0 0 1-1.5-1.5v-8A1.5 1.5 0 0 1 4 2h8a1.5 1.5 0 0 1 1.5 1.5V4" />
            </svg>
            <span id="copy-code-label">Copy</span>
          </button>
        </div>
      </div>

      <!-- Panels -->
      {snippets.map((s, idx) => (
        <div
          data-tab-panel={s.id}
          data-raw-code={s.code}
          data-header-url={s.headerUrl}
          class={idx === 0 ? "code-panel block" : "code-panel hidden"}
        >
          <div class="flex items-center justify-between border-b border-white/[0.06] bg-[#080A0F] px-6 py-2.5 font-mono text-[11px] text-[#8B93A4] sm:px-7">
            <span>{s.filename}</span>
            <span>-std=c++20 -Wall -Wextra -Werror</span>
          </div>
          <pre class="overflow-x-auto p-6 text-[13.5px] leading-[1.7] sm:p-7"><code set:html={highlightCpp(s.code)} /></pre>
        </div>
      ))}
    </div>

    <!-- Compact Quickstart / CLI install bar -->
    <div class="mt-6 overflow-hidden rounded-xl border border-white/[0.12] bg-[#0B0E14]/95 shadow-xl backdrop-blur-md">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.07] bg-[#080A0F] px-5 py-2.5 sm:px-6">
        <div class="flex items-center gap-2 font-mono text-[11px] font-medium tracking-wider text-[#9CA3AF] uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-[#14B8A6]"></span>
          <span>Quickstart CLI</span>
        </div>

        <div class="flex items-center gap-1.5" role="tablist" aria-label="Quickstart CLI commands">
          {quickstartCommands.map((cmd, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
              data-cli-id={cmd.id}
              data-cli-command={cmd.command}
              class={`cli-tab rounded-md px-2.5 py-1 font-mono text-[11px] font-medium whitespace-nowrap transition-colors duration-150 ${
                idx === 0
                  ? "bg-[#3B82F6]/20 text-[#93C5FD] ring-1 ring-[#3B82F6]/40"
                  : "text-[#9CA3AF] hover:bg-white/[0.05] hover:text-white"
              }`}
            >
              {cmd.label}
            </button>
          ))}
        </div>
      </div>

      <div class="flex items-center justify-between gap-4 px-5 py-3.5 sm:px-6">
        <div class="flex min-w-0 items-center gap-3 overflow-x-auto">
          <span class="shrink-0 font-mono text-sm font-semibold text-[#14B8A6] select-none">$</span>
          <code id="cli-cmd-text" class="font-mono text-[13px] whitespace-nowrap text-white">
            {quickstartCommands[0].command}
          </code>
        </div>

        <button
          id="copy-cli-btn"
          type="button"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/[0.12] bg-white/[0.04] px-3.5 py-1.5 font-mono text-xs font-medium text-[#CBD5E1] transition-colors duration-150 hover:border-white/30 hover:text-white"
        >
          <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="7" y="7" width="9" height="9" rx="1.5" />
            <path d="M4.5 13H4a1.5 1.5 0 0 1-1.5-1.5v-8A1.5 1.5 0 0 1 4 2h8a1.5 1.5 0 0 1 1.5 1.5V4" />
          </svg>
          <span id="copy-cli-label">Copy</span>
        </button>
      </div>
    </div>

    <div class="mt-8">
      <a
        href={includeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/[0.22] px-6 py-3 text-sm font-semibold text-white transition-all duration-150 hover:border-white/50 hover:bg-white/[0.05]"
      >
        <span>Explore C++20 Headers</span>
      </a>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".code-tab");
  const panels = document.querySelectorAll<HTMLElement>(".code-panel");
  const copyBtn = document.getElementById("copy-code-btn");
  const copyLabel = document.getElementById("copy-code-label");
  const headerLink = document.getElementById("active-header-link") as HTMLAnchorElement | null;

  const cliTabs = document.querySelectorAll<HTMLButtonElement>(".cli-tab");
  const cliCmdText = document.getElementById("cli-cmd-text");
  const copyCliBtn = document.getElementById("copy-cli-btn");
  const copyCliLabel = document.getElementById("copy-cli-label");

  async function copyWithFeedback(text: string, labelEl: HTMLElement): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
      labelEl.textContent = "Copied";
      setTimeout(() => {
        labelEl.textContent = "Copy";
      }, 1600);
    } catch {
      labelEl.textContent = "Failed";
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tabTarget;
      if (!target) return;

      tabs.forEach((t) => {
        const active = t.dataset.tabTarget === target;
        t.setAttribute("aria-selected", String(active));
        t.className = active
          ? "code-tab relative -mb-px shrink-0 border-b-2 border-[#38BDF8] py-3.5 text-sm font-medium whitespace-nowrap text-white transition-colors duration-150"
          : "code-tab relative -mb-px shrink-0 border-b-2 border-transparent py-3.5 text-sm font-medium whitespace-nowrap text-[#A1A6B3] hover:text-white transition-colors duration-150";
      });

      panels.forEach((p) => {
        const isMatch = p.dataset.tabPanel === target;
        p.classList.toggle("hidden", !isMatch);
        p.classList.toggle("block", isMatch);
        if (isMatch && headerLink && p.dataset.headerUrl) {
          headerLink.href = p.dataset.headerUrl;
        }
      });
    });
  });

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener("click", () => {
      const visible = Array.from(panels).find((p) => !p.classList.contains("hidden"));
      const raw = visible?.dataset.rawCode;
      if (raw) void copyWithFeedback(raw, copyLabel);
    });
  }

  cliTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const cmd = tab.dataset.cliCommand;
      const id = tab.dataset.cliId;
      if (!cmd || !id) return;

      cliTabs.forEach((t) => {
        const active = t.dataset.cliId === id;
        t.setAttribute("aria-selected", String(active));
        t.className = active
          ? "cli-tab rounded-md px-2.5 py-1 font-mono text-[11px] font-medium whitespace-nowrap transition-colors duration-150 bg-[#3B82F6]/20 text-[#93C5FD] ring-1 ring-[#3B82F6]/40"
          : "cli-tab rounded-md px-2.5 py-1 font-mono text-[11px] font-medium whitespace-nowrap transition-colors duration-150 text-[#9CA3AF] hover:bg-white/[0.05] hover:text-white";
      });

      if (cliCmdText) {
        cliCmdText.textContent = cmd;
      }
    });
  });

  if (copyCliBtn && copyCliLabel && cliCmdText) {
    copyCliBtn.addEventListener("click", () => {
      const cmd = cliCmdText.textContent?.trim();
      if (cmd) void copyWithFeedback(cmd, copyCliLabel);
    });
  }
</script>
