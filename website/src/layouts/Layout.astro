---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ChronoRing — C++20 Lock-Free Telemetry & SIMD Trigger Engine",
  description = "Ultra-low-latency C++20 wait-free ring buffers, AVX2/AVX-512 SIMD trigger filtering, zero-copy columnar persistence, and TLA+/Lean 4 formal verification for high-rate detector DAQ systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#19191C" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#19191C] text-[#F4F5F7] antialiased selection:bg-[#3B82F6]/30 selection:text-white">
    <slot />
  </body>
</html>
