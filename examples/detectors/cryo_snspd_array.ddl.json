{
  "detector": {
    "name": "cryo_snspd_array",
    "kind": "SNSPD",
    "channels": 64
  },
  "transport": {
    "kind": "spsc",
    "ring_capacity": 16384,
    "cpu_core": -1
  },
  "calibration": {
    "gain_mev_per_unit": 1.5,
    "offset_mev": 0.25,
    "time_walk_ps_per_unit": 0.1,
    "nominal_bath_temp_mk": 85.0,
    "max_temp_drift_mk": 5.0,
    "max_bias_ua": 45.0
  },
  "trigger": {
    "min_energy_mev": 5.0,
    "max_energy_mev": 5000.0,
    "max_abs_timing_ps": 150.0,
    "max_pileup_score": 0.4,
    "min_multiplicity": 2
  },
  "persistence": {
    "output_path": "cryo_snspd_array.crng",
    "secondary_output_path": "cryo_snspd_array.bak.crng",
    "enable_compression": true,
    "projection_mask": "chronoring::kColAll"
  },
  "observability": {
    "prometheus": true
  }
}
